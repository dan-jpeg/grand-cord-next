generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?
  keywords        String[] @default([])
  designerNames   String[] @default([])
  material        String?
  color           String?
  colorHex        String?
  attribute1      String?
  attribute2      String?
  price           Float
  images          Json     @default("[]") // Change from String[] to Json
  published       Boolean  @default(false)
  stripeProductId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sizes            ProductSize[]
  collections      CollectionProduct[]
  sizingAttributes ProductSizingAttribute[]

  @@index([slug])
  @@index([published])
}

model ProductSize {
  id        String   @id @default(cuid())
  productId String
  size      String
  available Int      @default(0) // Can be sold
  committed Int      @default(0) // Reserved for orders
  total     Int      @default(0) // Total physical inventory (available + committed)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  product      Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  measurements ProductSizeMeasurement[]

  @@unique([productId, size])
  @@index([productId])
}

model Collection {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  showInCatalog Boolean  @default(false)
  showInSample  Boolean  @default(false)
  showInSearch  Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products CollectionProduct[]

  @@index([slug])
}

model CollectionProduct {
  collectionId String
  productId    String
  order        Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([collectionId])
  @@index([productId])
}

model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique
  email                 String
  status                OrderStatus @default(PENDING)
  total                 Float
  shippingAddress       Json
  trackingNumber        String?
  trackingUrl           String?
  stripePaymentIntentId String
  notes                 String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  items OrderItem[]

  @@index([email])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  CANCELLED
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  productId   String
  productName String
  productSlug String
  size        String
  quantity    Int
  price       Float

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String
  excerpt     String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([published])
  @@index([publishedAt])
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryChanges InventoryChangeLog[]

  @@index([email])
}

model SizingAttribute {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products     ProductSizingAttribute[]
  measurements ProductSizeMeasurement[]

  @@index([category])
}

// Declares which sizing attributes apply to a given product, and in what order.
model ProductSizingAttribute {
  productId         String
  sizingAttributeId String
  sortOrder         Int    @default(0)

  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizingAttribute SizingAttribute @relation(fields: [sizingAttributeId], references: [id], onDelete: Cascade)

  @@id([productId, sizingAttributeId])
  @@index([productId])
  @@index([sizingAttributeId])
}

// One measurement value per product size per sizing attribute.
model ProductSizeMeasurement {
  productSizeId     String
  sizingAttributeId String
  value             String

  productSize     ProductSize     @relation(fields: [productSizeId], references: [id], onDelete: Cascade)
  sizingAttribute SizingAttribute @relation(fields: [sizingAttributeId], references: [id], onDelete: Cascade)

  @@id([productSizeId, sizingAttributeId])
  @@index([productSizeId])
  @@index([sizingAttributeId])
}

model SiteSettings {
  // Single-row table — `id` is fixed to "default".
  id                              String   @id @default("default")
  showSearchInNav                 Boolean  @default(true)
  showSampleInNav                 Boolean  @default(true)
  scrollToTopOnCatalogTapMobile   Boolean  @default(false)
  scrollToTopOnCatalogTapDesktop  Boolean  @default(false)
  welcomeMessage                  String?
  updatedAt                       DateTime @updatedAt
}

model InventoryChangeLog {
  id            String   @id @default(cuid())
  productId     String?
  productSizeId String?
  productName   String
  sizeLabel     String
  delta         Int
  before        Int
  after         Int
  adminUserId   String?
  adminEmail    String
  adminName     String?
  // Which counter moved: "available" for manual edits and cancel restores,
  // "total" when shipping takes stock off the shelf. Null on rows written
  // before order transitions were logged.
  field         String?
  // Why the stock moved. Null means a manual edit from the product screen.
  reason        String?
  orderId       String?
  orderNumber   String?
  createdAt     DateTime @default(now())

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([productSizeId])
  @@index([adminUserId])
  @@index([createdAt])
  @@index([orderId])
}

/// Failed admin sign-in attempts, for throttling. Only failures are stored; a
/// successful sign-in deletes the identifier's rows. Pruned on write, so this
/// stays small without a scheduled job.
model LoginAttempt {
  id         String   @id @default(cuid())
  /// The submitted login, lowercased. Not a foreign key — attempts against
  /// addresses that do not exist have to be counted too, or the throttle
  /// becomes a way to test which addresses are real.
  identifier String
  ip         String?
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
}
